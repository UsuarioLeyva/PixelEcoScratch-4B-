<script>
  // Ambient floating leaf-pixels — fixed behind all content, never rendered over the QR frame
  const field = document.getElementById('leafField');
  const colors = ['#74C69D', '#B7E4C7', '#FFD60A', '#40663f'];
  const total = 22;

  for (let i = 0; i < total; i++) {
    const el = document.createElement('div');
    el.className = 'leaf-particle';
    const size = 6 + Math.random() * 8;
    el.style.width = size + 'px';
    el.style.height = size + 'px';
    el.style.left = Math.random() * 100 + 'vw';
    el.style.background = colors[Math.floor(Math.random() * colors.length)];
    el.style.borderRadius = Math.random() > .5 ? '50%' : '0 60% 0 60%';
    const duration = 10 + Math.random() * 10;
    el.style.animationDuration = duration + 's';
